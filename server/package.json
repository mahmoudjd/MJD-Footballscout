{
  "name": "mjd-football-scout-backend",
  "version": "2.0.0",
  "description": "Express and MongoDB API for the MJD Football Scout player intelligence and recruitment platform.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "DOTENV_CONFIG_PATH=.env.development.local tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --external:express --external:cors --external:mongoose",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "start": "node dist/index.js"
  },
  "author": "Mahmoud Al Jarad",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.1",
    "bcryptjs": "3.0.3",
    "cheerio": "1.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "8.3.0",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "9.0.3",
    "mongodb": "^7.9.0",
    "mongoose": "^9.12.2",
    "tsx": "^4.23.15",
    "winston": "3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^7.0.2"
  },
  "dockerfile": {
    "secrets": [
      "MONGOURI"
    ]
  }
}
