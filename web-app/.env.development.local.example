NEXT_PUBLIC_API_HOST=http://localhost:8080
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=replace-with-a-local-secret-at-least-32-characters
GOOGLE_CLIENT_ID=local-google-login-disabled
GOOGLE_CLIENT_SECRET=local-google-login-disabled
# Same value in web-app and server. Generate with: openssl rand -base64 32
# Lets the API trust the browser IP/location forwarded by the Next.js server.
PROXY_SHARED_SECRET=
